-- ============================================================================
-- SP 2: CARGA DE HECHOS SACRAMENTALES (dw.Fact_Sacramento)
-- ============================================================================
CREATE OR ALTER PROCEDURE dw.usp_ETL_Cargar_Fact_Sacramento
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @UbicacionKey INT = (
        SELECT TOP 1 UbicacionKey FROM dw.Dim_Ubicacion WHERE NombreSede = 'Parroquia Nuestra Señora de la Paz'
    );

    INSERT INTO staging.Cuarentena_Inconsistencias (TablaOrigen, TipoInconsistencia, DetalleError, DatosCrudos)
    SELECT
        'staging.Bautizos',
        'ANIO_NULO_IMPUTADO',
        'Acta de bautizo sin año; imputado al año modal del libro (2025)',
        CONCAT('Libro=', Nro_Libro, ', Acta=', Nro_Acta, ', Folio=', Folio)
    FROM staging.Bautizos
    WHERE TRY_CAST(TRY_CAST(Anio AS FLOAT) AS INT) IS NULL;

    INSERT INTO staging.Cuarentena_Inconsistencias (TablaOrigen, TipoInconsistencia, DetalleError, DatosCrudos)
    SELECT
        'staging.Matrimonios',
        'ANIO_NULO_IMPUTADO',
        'Acta de matrimonio sin año; imputado por continuidad cronológica (2012)',
        CONCAT('Libro=', Nro_Libro, ', Acta=', Nro_Acta, ', Folio=', Folio)
    FROM staging.Matrimonios
    WHERE TRY_CAST(TRY_CAST(Anio AS FLOAT) AS INT) IS NULL;

    TRUNCATE TABLE dw.Fact_Sacramento;

    ;WITH SacramentosUnificados AS (
        SELECT
            TRY_CAST(TRY_CAST(Nro_Acta AS FLOAT) AS INT) AS NumeroActa,
            TRY_CAST(TRY_CAST(Nro_Libro AS FLOAT) AS INT) AS NumeroLibro,
            TRY_CAST(TRY_CAST(Folio AS FLOAT) AS INT) AS NumeroFolio,
            UPPER(LTRIM(RTRIM(Cod_Sacramento))) AS CodigoSacramento,
            ISNULL(TRY_CAST(TRY_CAST(Anio AS FLOAT) AS INT), 2025) AS AnioLimpio,
            CONVERT(CHAR(64), HASHBYTES('SHA2_256',
                UPPER(LTRIM(RTRIM(
                    ISNULL(Apellido_Paterno, 'NO REGISTRADO') + ' ' +
                    ISNULL(Apellido_Materno, '') + ' ' +
                    ISNULL(Nombres, '')
                ))) + '|BASAV_2026_2_PNSP'
            ), 2) AS FeligresHash
        FROM staging.Bautizos

        UNION ALL

        SELECT
            TRY_CAST(TRY_CAST(Nro_Acta AS FLOAT) AS INT) AS NumeroActa,
            TRY_CAST(TRY_CAST(Nro_Libro AS FLOAT) AS INT) AS NumeroLibro,
            TRY_CAST(TRY_CAST(Folio AS FLOAT) AS INT) AS NumeroFolio,
            UPPER(LTRIM(RTRIM(Cod_Sacramento))) AS CodigoSacramento,
            ISNULL(TRY_CAST(TRY_CAST(Anio AS FLOAT) AS INT), 2012) AS AnioLimpio,
            CONVERT(CHAR(64), HASHBYTES('SHA2_256',
                UPPER(LTRIM(RTRIM(
                    ISNULL(Ap_Pat_Esposo, 'NO REGISTRADO') + ' ' +
                    ISNULL(Ap_Mat_Esposo, '') + ' ' +
                    ISNULL(Nombres_Esposo, '')
                ))) + '|BASAV_2026_2_PNSP'
            ), 2) AS FeligresHash
        FROM staging.Matrimonios
    )
    INSERT INTO dw.Fact_Sacramento (
        TiempoKey, FeligresKey, TipoSacramentoKey, UbicacionKey,
        NumeroLibro, NumeroFolio, NumeroActa, TiempoEmisionSeg, Cantidad
    )
    SELECT
        (s.AnioLimpio * 10000) + 101 AS TiempoKey,
        df.FeligresKey,
        dt.TipoSacramentoKey,
        @UbicacionKey,
        s.NumeroLibro,
        ISNULL(s.NumeroFolio, 0),
        s.NumeroActa,
        45,
        1
    FROM SacramentosUnificados s
    INNER JOIN dw.Dim_Feligres df ON df.FeligresHash = s.FeligresHash
    INNER JOIN dw.Dim_TipoSacramento dt ON dt.CodigoSacramento = s.CodigoSacramento;
END
GO

-- ============================================================================
-- SP 3: CARGA DE HECHOS FINANCIEROS (dw.Fact_Finanzas + Cuarentena)
-- ============================================================================
CREATE OR ALTER PROCEDURE dw.usp_ETL_Cargar_Fact_Finanzas
AS
BEGIN
    SET NOCOUNT ON;
    SET DATEFORMAT dmy;

    DECLARE @UbicacionKey INT = (
        SELECT TOP 1 UbicacionKey FROM dw.Dim_Ubicacion WHERE NombreSede = 'Parroquia Nuestra Señora de la Paz'
    );

    INSERT INTO staging.Cuarentena_Inconsistencias (TablaOrigen, TipoInconsistencia, DetalleError, DatosCrudos)
    SELECT
        'staging.Ingresos',
        'FECHA_FUERA_DE_EJERCICIO',
        'Fecha en año 2026 corregida al ejercicio fiscal 2025',
        CONCAT('Recibo=', ISNULL(RECIBO,'SIN_RECIBO'), ', Fecha=', FECHA, ', Detalle=', DETALLE, ', Aporte=', APORTE)
    FROM staging.Ingresos
    WHERE YEAR(TRY_CAST(LTRIM(RTRIM(FECHA)) AS DATE)) = 2026;

    INSERT INTO staging.Cuarentena_Inconsistencias (TablaOrigen, TipoInconsistencia, DetalleError, DatosCrudos)
    SELECT
        'staging.Ingresos',
        'METODO_PAGO_INVALIDO',
        CONCAT('Método no reconocido (', ISNULL(REPLACE(METODO, CHAR(13), ''),'NULL'), ') imputado a NO REGISTRADO'),
        CONCAT('Recibo=', ISNULL(RECIBO,'SIN_RECIBO'), ', Fecha=', FECHA, ', Detalle=', DETALLE, ', Aporte=', APORTE)
    FROM staging.Ingresos
    WHERE UPPER(LTRIM(RTRIM(REPLACE(ISNULL(METODO,''), CHAR(13), '')))) NOT IN ('EFECTIVO', 'BANCO', 'YAPE', 'TRANSACCION');

    INSERT INTO staging.Cuarentena_Inconsistencias (TablaOrigen, TipoInconsistencia, DetalleError, DatosCrudos)
    SELECT
        'staging.Egresos',
        'DESCRIPCION_NULA',
        'Egreso sin descripción imputado a NO REGISTRADO',
        CONCAT('Fecha=', FECHA, ', Monto=', REPLACE(MONTO, CHAR(13), ''))
    FROM staging.Egresos
    WHERE DETALLE IS NULL OR LTRIM(RTRIM(DETALLE)) = '';

    TRUNCATE TABLE dw.Fact_Finanzas;

    INSERT INTO dw.Fact_Finanzas (
        TiempoKey, ConceptoKey, UbicacionKey, NumeroComprobante,
        MontoIngreso, MontoEgreso, CantidadOperaciones
    )
    SELECT
        CONVERT(INT, FORMAT(
            CASE
                WHEN YEAR(TRY_CAST(LTRIM(RTRIM(i.FECHA)) AS DATE)) = 2026
                    THEN DATEFROMPARTS(2025, MONTH(TRY_CAST(LTRIM(RTRIM(i.FECHA)) AS DATE)), DAY(TRY_CAST(LTRIM(RTRIM(i.FECHA)) AS DATE)))
                ELSE TRY_CAST(LTRIM(RTRIM(i.FECHA)) AS DATE)
            END, 'yyyyMMdd'
        )) AS TiempoKey,
        dc.ConceptoKey,
        @UbicacionKey,
        ISNULL(NULLIF(LTRIM(RTRIM(i.RECIBO)), ''), 'SIN_RECIBO'),
        TRY_CAST(LTRIM(RTRIM(REPLACE(i.APORTE, CHAR(13), ''))) AS DECIMAL(12,2)),
        0.00,
        1
    FROM staging.Ingresos i
    INNER JOIN dw.Dim_ConceptoFinanciero dc
        ON dc.TipoMovimiento = 'INGRESO'
       AND dc.DetalleEstandar = CASE UPPER(LTRIM(RTRIM(ISNULL(i.DETALLE, 'NO REGISTRADO'))))
                                    WHEN 'EFF' THEN 'EEF'
                                    WHEN 'CANCIONERO' THEN 'CANCIONEROS'
                                    ELSE UPPER(LTRIM(RTRIM(ISNULL(i.DETALLE, 'NO REGISTRADO'))))
                                END
       AND dc.MedioPago = CASE
                              WHEN UPPER(LTRIM(RTRIM(REPLACE(ISNULL(i.METODO, ''), CHAR(13), '')))) IN ('EFECTIVO', 'BANCO', 'YAPE', 'TRANSACCION')
                                  THEN UPPER(LTRIM(RTRIM(REPLACE(i.METODO, CHAR(13), ''))))
                              ELSE 'NO REGISTRADO'
                          END
    WHERE TRY_CAST(LTRIM(RTRIM(REPLACE(i.APORTE, CHAR(13), ''))) AS DECIMAL(12,2)) > 0;

    INSERT INTO dw.Fact_Finanzas (
        TiempoKey, ConceptoKey, UbicacionKey, NumeroComprobante,
        MontoIngreso, MontoEgreso, CantidadOperaciones
    )
    SELECT
        CONVERT(INT, FORMAT(TRY_CAST(LTRIM(RTRIM(e.FECHA)) AS DATE), 'yyyyMMdd')) AS TiempoKey,
        dc.ConceptoKey,
        @UbicacionKey,
        'NO_APLICA',
        0.00,
        TRY_CAST(LTRIM(RTRIM(REPLACE(e.MONTO, CHAR(13), ''))) AS DECIMAL(12,2)),
        1
    FROM staging.Egresos e
    INNER JOIN dw.Dim_ConceptoFinanciero dc
        ON dc.TipoMovimiento = 'EGRESO'
       AND dc.DetalleEstandar = UPPER(LTRIM(RTRIM(ISNULL(e.DETALLE, 'NO REGISTRADO'))))
    WHERE TRY_CAST(LTRIM(RTRIM(REPLACE(e.MONTO, CHAR(13), ''))) AS DECIMAL(12,2)) > 0;
END
GO

-- ============================================================================
-- SP 4: ORQUESTADOR PRINCIPAL
-- ============================================================================
CREATE OR ALTER PROCEDURE dw.usp_Orquestador_ETL_Principal
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @Inicio DATETIME = GETDATE();
    DECLARE @LogID INT;

    INSERT INTO dw.Log_Ejecucion_ETL (Proceso, FechaInicio, Estado)
    VALUES ('usp_Orquestador_ETL_Principal', @Inicio, 'EN_EJECUCION');
    SET @LogID = SCOPE_IDENTITY();

    BEGIN TRY
        BEGIN TRANSACTION;

        TRUNCATE TABLE staging.Cuarentena_Inconsistencias;

        EXEC dw.usp_ETL_Cargar_Dimensiones;
        EXEC dw.usp_ETL_Cargar_Fact_Sacramento;
        EXEC dw.usp_ETL_Cargar_Fact_Finanzas;

        COMMIT TRANSACTION;

        DECLARE @TotalFilas INT = (
            SELECT (SELECT COUNT(*) FROM dw.Fact_Sacramento) + (SELECT COUNT(*) FROM dw.Fact_Finanzas)
        );

        UPDATE dw.Log_Ejecucion_ETL
        SET FechaFin        = GETDATE(),
            DuracionMs      = DATEDIFF(MILLISECOND, @Inicio, GETDATE()),
            FilasInsertadas = @TotalFilas,
            Estado          = 'EXITOSO'
        WHERE LogID = @LogID;
    END TRY
    BEGIN CATCH
        IF @@TRANCOUNT > 0 ROLLBACK TRANSACTION;

        UPDATE dw.Log_Ejecucion_ETL
        SET FechaFin     = GETDATE(),
            DuracionMs   = DATEDIFF(MILLISECOND, @Inicio, GETDATE()),
            Estado       = 'ERROR',
            MensajeError = ERROR_MESSAGE()
        WHERE LogID = @LogID;

        THROW;
    END CATCH
END
GO
